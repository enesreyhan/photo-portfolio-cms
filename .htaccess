# ========================================================
# .htaccess
# Apache / LiteSpeed Yönlendirme ve Güvenlik Kuralları
# ========================================================

# Dizin Listelemeyi Kapat ve Varsayılan Dosyayı index.php Yap
Options -Indexes
DirectoryIndex index.php index.html

# Güvenlik Başlıkları
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # HSTS yalnızca HTTPS yanıtlarında (lokal HTTP geliştirmeyi etkilemez)
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    # Temel CSP: eklenti, <base> ve site dışına form gönderimi kapalı (satır içi script kullanıldığı için script-src kısıtlanmıyor)
    Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    # Yüklenen SVG'ler doğrudan açılırsa içlerindeki script çalışmasın
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    </FilesMatch>
</IfModule>

# Hassas Dosyaları Dışarıdan Doğrudan Erişime Kapat
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sqlite|sqlite3|db|sw[op]|md|env.*)|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# router.php yalnızca yerel "php -S" içindir
<FilesMatch "^(config\.php|router\.php|deploy\.sh|start\.sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# AVIF ve WebP MIME Tipleri
<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>

# Gzip / Brotli Sıkıştırma (Performans Artışı)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Tarayıcı Önbellekleme (Browser Caching)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# URL Yönlendirmeleri
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Sunucu tarafı parçalar (includes/ ve admin/includes/) tarayıcıdan açılamaz; site bunları kendisi yükler
    RewriteRule ^(admin/)?includes(/|$) - [F,L]
    # Komut satırı betikleri ve veritabanı dosyaları web'den açılamaz
    RewriteRule ^scripts(/|$) - [F,L]
    RewriteRule \.(db|sqlite|sql|bak.*)$ - [F,L,NC]
    # Medya klasörlerinde betik çalıştırılamaz
    RewriteRule ^(uploads|content)/.*\.(php[0-9]?|phtml|phar|phps|cgi|pl|py|sh)$ - [F,L,NC]

    # HTTP -> HTTPS Yönlendirmesi (Canlı Sunucu İçin)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Atom, RSS ve Sitemap yönlendirmeleri
    RewriteRule ^atom\.xml$ atom.php [L,QSA]
    RewriteRule ^rss\.xml$ rss.php [L,QSA]
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
    RewriteRule ^robots\.txt$ robots.php [L]

    # Mevcut dosya veya dizin varsa doğrudan sun (css, js, resimler vb.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Geri kalan tüm istekleri index.php'ye yönlendir
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>
